      "channel": 0,
      "offset": 200000,
      "duration": 17800000,
      "text": "Thank you for calling North Star Telecom."
    },
    {
      "id": "turn-0002",
      "participantId": "REP",
      "channel": 0,
      "offset": 65200000,
      "duration": 9600000,
      "text": "My name is Maya."
    },
    {
      "id": "turn-0003",
      "participantId": "REP",
      "channel": 0,
      "offset": 81200000,
      "duration": 11199999,
      "text": "How may I help you today?"
    },
    {
      "id": "turn-0004",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 98800000,
      "duration": 5199999,
      "text": "Hello?"
    },
    {
      "id": "turn-0005",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 113600000,
      "duration": 11600000,
      "text": "Yes, hello, dear."
    },
    {
      "id": "turn-0006",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 131000000,
      "duration": 30600000,
      "text": "I am hoping you can help me get internet put in at my house."
    },
    {
      "id": "turn-0007",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 168200000,
      "duration": 59200000,
      "text": "The television is fine, but my grandson says I need the internet for the video doctor visits."
    },
    {
      "id": "turn-0008",
      "participantId": "REP",
      "channel": 0,
      "offset": 232600000,
      "duration": 41400000,
      "text": "I can absolutely help with that. Before we begin, may I have your full name?"
    },
    {
      "id": "turn-0009",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 280200000,
      "duration": 43400000,
      "text": "It is Eleanor June Whitaker. Eleanor, like the president's wife."
    },
    {
      "id": "turn-0010",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 329000000,
      "duration": 41600000,
      "text": "And Whittaker, W-H-I-T-A-K-E-R."
    },
    {
      "id": "turn-0011",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 379000000,
      "duration": 29200000,
      "text": "I am 82, so you may have to speak a little slowly for me."
    },
    {
      "id": "turn-0012",
      "participantId": "REP",
      "channel": 0,
      "offset": 414600000,
      "duration": 53400000,
      "text": "Of course, Ms. Whitaker, I will go slowly. Are you looking for internet service only?"
    },
    {
      "id": "turn-0013",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 476200000,
      "duration": 52400000,
      "text": "Yes, internet only. I do not need all those channels. My neighbor said the regular plan would do."
    },
    {
      "id": "turn-0014",
      "participantId": "REP",
      "channel": 0,
      "offset": 537000000,
      "duration": 91000000,
      "text": "We have a 300 megabit internet plan available in your area for 55 dollars per month, plus taxes and fees. It includes a Wi-Fi gateway. Would that work for you?"
    },
    {
      "id": "turn-0015",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 635600000,
      "duration": 9000000,
      "text": "300."
    },
    {
      "id": "turn-0016",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 650800000,
      "duration": 12999999,
      "text": "What did you say, megabytes?"
    },
    {
      "id": "turn-0017",
      "participantId": "REP",
      "channel": 0,
      "offset": 669200000,
      "duration": 53400000,
      "text": "300 megabits. It is a good plan for video calls, browsing, and streaming."
    },
    {
      "id": "turn-0018",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 730200000,
      "duration": 18400000,
      "text": "Oh yes, that sounds right."
    },
    {
      "id": "turn-0019",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 782400000,
      "duration": 32600000,
      "text": "I have to find my papers. They are in this little blue folder."
    },
    {
      "id": "turn-0020",
      "participantId": "REP",
      "channel": 0,
      "offset": 822800000,
      "duration": 7800000,
      "text": "Take your time."

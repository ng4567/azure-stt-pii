    {
      "id": "turn-0059",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 2077000000,
      "duration": 51199999,
      "text": "Yes, but please also call me. I do not always see the computer messages right away."
    },
    {
      "id": "turn-0060",
      "participantId": "REP",
      "channel": 0,
      "offset": 2136600000,
      "duration": 75600000,
      "text": "Certainly. For identity verification, I will need your date of birth and the last four digits of your social security number."
    },
    {
      "id": "turn-0061",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 2220800000,
      "duration": 45600000,
      "text": "My birthday is February 29th, 1944."

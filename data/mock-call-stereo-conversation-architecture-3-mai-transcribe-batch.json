      "id": "turn-0027",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 1041800000,
      "duration": 80399999,
      "text": "It is 742 Evergreen Terrace. Wait, no, that is not right. That is the address from an old television show."
    },
    {
      "id": "turn-0028",
      "participantId": "CUSTOMER",
      "channel": 1,
      "offset": 1128800000,
      "duration": 82400000,
      "text": "My address is 1847 Willowbrook Lane, Apartment 3B, Brookhaven, New York, 11719."
